---
// The five-step posture scale with this county's current spot and, if known,
// where it stood before. The line between the two markers shows which way it moved.
import { postures } from "../config";
import type { County } from "../lib/counties";
import { postureText } from "../lib/counties";

interface Props {
  county: County;
  year?: number;
}
const { county: c, year } = Astro.props;
const n = postures.length;
const idx = (label: string) => postures.findIndex((p) => p.label === label);
const now = c.posture ? idx(c.posture.label) : -1;
const prev = c.posture?.previous;
const before = prev ? idx(prev.label) : -1;
const moved = now >= 0 && before >= 0 && before !== now;
const center = (i: number) => ((i + 0.5) / n) * 100;
const summary = `${postureText(c)}.${prev ? ` Was ${prev.label} in ${prev.year}.` : ""}`;
---

<div class="posture">
  <p class="posture-line">
    <span class="posture-now">{c.posture?.label ?? "Posture not set"}</span>
    {c.posture?.trend && <span class="posture-trend">trending {c.posture.trend}</span>}
  </p>

  <div class="scale" role="img" aria-label={`Posture scale. ${summary}`}>
    <div class="track">
      {
        moved && (
          <span
            class="move"
            style={`left:${Math.min(center(now), center(before))}%;width:${Math.abs(center(now) - center(before))}%`}
          />
        )
      }
      {moved && <span class="marker was" style={`left:${center(before)}%`} data-year={prev!.year} />}
      {now >= 0 && <span class="marker now" style={`left:${center(now)}%`} data-year={year ?? ""} />}
    </div>
    <div class="bars">
      {postures.map((p) => <span style={`background:${p.color}`} />)}
    </div>
    <div class="labels">
      {postures.map((p, i) => <span class:list={{ on: i === now }}>{p.label}</span>)}
    </div>
  </div>

  {prev && <p class="posture-was">Was {prev.label} in {prev.year}.</p>}
</div>

<style>
  .posture-line {
    margin: 0 0 0.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.75rem;
  }
  .posture-now {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .posture-trend {
    font-size: 1.125rem;
    color: var(--color-ink-2);
  }
  .scale {
    max-width: 34rem;
  }
  .track {
    position: relative;
    height: 2.4rem;
  }
  .move {
    position: absolute;
    bottom: 0.55rem;
    height: 2px;
    background: var(--color-ink);
  }
  .marker {
    position: absolute;
    bottom: 0.55rem;
    transform: translate(-50%, 50%);
    border-radius: 50%;
  }
  .marker::before {
    content: attr(data-year);
    position: absolute;
    bottom: calc(100% + 0.2rem);
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.8125rem;
    color: var(--color-ink-2);
    white-space: nowrap;
  }
  .marker.now {
    width: 1rem;
    height: 1rem;
    background: var(--color-ink);
    box-shadow: 0 0 0 2px var(--color-surface);
  }
  .marker.now::before {
    font-weight: 700;
    color: var(--color-ink);
  }
  .marker.was {
    width: 0.8rem;
    height: 0.8rem;
    background: var(--color-surface);
    border: 2px solid var(--color-ink-2);
  }
  .bars,
  .labels {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 4px;
  }
  .bars span {
    height: 0.9rem;
    border-radius: 4px;
  }
  .labels span {
    text-align: center;
    font-size: 0.875rem;
    color: var(--color-ink-2);
    padding-top: 0.35rem;
  }
  .labels span.on {
    color: var(--color-ink);
    font-weight: 800;
  }
  .posture-was {
    margin: 0.75rem 0 0;
    font-size: 0.9375rem;
    color: var(--color-ink-2);
  }
</style>
