---
import Base from "../layouts/Base.astro";
import { definitions, defaultSources, postureCutoffs, postures } from "../config";
---

<Base title="Methodology" description="How county margins, shifts, and postures are measured.">
  <div class="wrap page">
    <h1>Methodology</h1>

    <section>
      <h2>Definitions</h2>
      <dl>
        {
          definitions.map((d) => (
            <div>
              <dt>{d.term}</dt>
              <dd>{d.text}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section>
      <h2>Posture labels</h2>
      <ul class="scale">
        {postures.map((p) => <li><span class="swatch" style={`background:${p.color}`} />{p.label}</li>)}
      </ul>
      <p>
        Cutoffs:{" "}
        {postureCutoffs
          ? `Safe at ${postureCutoffs.safe} points or more, Lean from ${postureCutoffs.lean} to ${postureCutoffs.safe} points, Swing under ${postureCutoffs.lean} points.`
          : "TBD"}
      </p>
    </section>

    <section>
      <h2>Sources</h2>
      <ul>
        {defaultSources.map((s) => <li>{s.name} ({s.use})</li>)}
      </ul>
      <p>
        County shapes come from the U.S. Census Bureau's 2017 cartographic boundary files, as packaged in us-atlas.
      </p>
    </section>

    <section>
      <h2>What precinct results can and can't show</h2>
      <p>
        Precinct totals show where the margin moved, not who changed their vote. Separating new voters from switchers
        requires the voter file.
      </p>
    </section>
  </div>
</Base>

<style>
  .page {
    padding-top: 3rem;
    max-width: var(--measure);
    margin-inline: auto;
  }
  .page h1 {
    font-size: clamp(2.25rem, 1.6rem + 2.4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    margin: 0 0 1rem;
  }
  .page h2 {
    font-size: 1.375rem;
    font-weight: 800;
    margin: 2.5rem 0 0.75rem;
    padding-top: 0.75rem;
    border-top: 3px solid var(--color-ink);
  }
  .page p,
  .page li,
  .page dd {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    line-height: 1.6;
  }
  .page dl {
    display: grid;
    gap: 1rem;
    margin: 0;
  }
  .page dt {
    font-weight: 700;
  }
  .page dd {
    margin: 0.2rem 0 0;
    color: var(--color-ink-2);
  }
  .scale {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    list-style: none;
    padding: 0;
  }
  .scale li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-sans);
    font-size: 1rem;
  }
</style>
