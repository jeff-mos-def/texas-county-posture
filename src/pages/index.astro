---
import Base from "../layouts/Base.astro";
import TexasMap from "../components/maps/TexasMap.astro";
import CountySearch from "../components/CountySearch.astro";
import { getProfiles, postureColor, postureText, POSTURE_UNSET_COLOR } from "../lib/counties";
import { site } from "../config";

const profiles = await getProfiles();
const latest = [...profiles]
  .sort((a, b) => b.profile.data.published.valueOf() - a.profile.data.published.valueOf())
  .slice(0, 6);
const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
---

<Base>
  <div class="wrap home">
    <div class="home-intro">
      <h1>{site.description}</h1>
      <p class="lede">
        Each profile reads a county's election results, precinct by precinct, and says which way it is moving. Colored
        counties have a profile. Point at any county to see where it stands.
      </p>
    </div>

    <div class="home-map">
      <TexasMap profiles={profiles} />
    </div>

    <div class="home-side">
      <CountySearch profiles={profiles} />

      <section aria-labelledby="latest-title" class="latest">
        <h2 id="latest-title">Latest profiles</h2>
        <ol>
          {
            latest.map((p) => (
              <li>
                <a href={p.href}>
                  <span class="latest-county">
                    <span class="swatch" style={`background:${postureColor(p.county.posture?.label) ?? POSTURE_UNSET_COLOR}`} />
                    {p.county.name}, {postureText(p.county)}
                  </span>
                  <span class="latest-title">{p.profile.data.title}</span>
                  <span class="latest-date">{fmtDate(p.profile.data.published)}</span>
                </a>
              </li>
            ))
          }
        </ol>
        <a class="all-link" href="/counties/">All counties</a>
      </section>
    </div>
  </div>
</Base>

<style>
  .home {
    display: grid;
    gap: 2rem 3.5rem;
    padding-top: 2.5rem;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "intro" "map" "side";
  }
  @media (min-width: 64rem) {
    .home {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      grid-template-areas: "map intro" "map side";
      grid-template-rows: auto 1fr;
    }
  }
  .home-intro {
    grid-area: intro;
  }
  .home-map {
    grid-area: map;
  }
  .home-side {
    grid-area: side;
  }
  .home-intro h1 {
    font-size: clamp(2rem, 1.5rem + 1.6vw, 2.75rem);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.025em;
    margin: 0;
    text-wrap: balance;
  }
  .lede {
    font-family: var(--font-serif);
    font-size: 1.1875rem;
    line-height: 1.55;
    color: var(--color-ink-2);
    margin: 1rem 0 0;
    max-width: 34rem;
  }
  .latest {
    margin-top: 2.5rem;
  }
  .latest h2 {
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0 0 0.5rem;
    padding-top: 0.75rem;
    border-top: 3px solid var(--color-ink);
  }
  .latest ol {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .latest li a {
    display: grid;
    gap: 0.2rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--color-grid);
    text-decoration: none;
  }
  .latest li a:hover .latest-title {
    text-decoration: underline;
  }
  .latest-county {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.875rem;
    color: var(--color-ink-2);
  }
  .latest-title {
    font-family: var(--font-serif);
    font-size: 1.1875rem;
    line-height: 1.3;
    font-weight: 600;
  }
  .latest-date {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .all-link {
    display: inline-block;
    margin-top: 1rem;
    font-weight: 700;
  }
</style>
