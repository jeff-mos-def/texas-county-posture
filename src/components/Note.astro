---
// A short method note inside a profile, set apart from the argument.
---

<aside class="note">
  <slot />
</aside>

<style>
  .note {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-ink-2);
    border-left: 3px solid var(--color-rule);
    padding: 0.15rem 0 0.15rem 1rem;
    margin: 0 0 1.5rem;
    max-width: var(--measure);
  }
</style>
